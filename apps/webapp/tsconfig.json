{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@engine/tsconfig/web-app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"]
    }
  },
  "references": [{ "path": "./tsconfig.node.json" }],
  "include": [
    "src",
    "*.ts",
    "*.tsx",
    "*.vue",
    "*.d.ts",
    "src/*.ts",
    "src/*.tsx",
    "src/*.vue",
    "src/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",
  ]
}
