{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@engine/tsconfig/library.json",
  "compilerOptions": {
    "types": ["@engine-core/typings/vue-router"]
  },
   "include": [
    "src",
    "*.ts",
    "*.tsx",
    "*.vue",
    "*.d.ts",
    "src/*.ts",
    "src/*.tsx",
    "src/*.vue",
    "src/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",
  ],
  "exclude": ["node_modules"]
}
