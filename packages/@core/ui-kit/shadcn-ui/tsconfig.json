{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@engine/tsconfig/web.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@engine-core/shadcn-ui/*": ["./src/*"]
    }
  },
   "include": [
    "src",
    "*.ts",
    "*.tsx",
    "*.vue",
    "*.d.ts",
    "src/*.ts",
    "src/*.tsx",
    "src/*.vue",
    "src/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",
  ],
  "exclude": ["node_modules"]
}
